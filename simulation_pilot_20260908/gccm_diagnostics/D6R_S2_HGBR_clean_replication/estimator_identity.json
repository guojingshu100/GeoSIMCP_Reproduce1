    "monotonic_cst": null,
    "n_iter_no_change": 10,
    "quantile": 0.5,
    "random_state": null,
    "scoring": "loss",
    "tol": 1e-07,
    "validation_fraction": 0.1,
    "verbose": 0,
    "warm_start": false
  },
  "sklearn_version": "1.6.1",
  "features": [
    "s_x",
    "s_y",
    "x1",
    "x2",
    "g_proxy",
    "x_noise"
